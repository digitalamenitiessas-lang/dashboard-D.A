# =====================================================================
# Copiar a .env.local y completar. El .env.local NO se sube al repo.
#
# Ojo con el prefijo: TODO lo que empieza con NEXT_PUBLIC_ se compila
# adentro del bundle y lo puede leer cualquiera que abra el navegador.
# Lo que no lleva el prefijo nunca sale de tu máquina — de acá lo toma
# `npm run push:setup` para cargarlo como secreto de Supabase.
# =====================================================================


# ---------------------------------------------------------------------
# Supabase — Project Settings → API
# ---------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu-anon-key

# No agregues acá la service_role key: saltea RLS por completo y el
# frontend no la necesita.


# ---------------------------------------------------------------------
# Notificaciones push
#
# No completes nada a mano: corré `npm run push:setup` y el script
# genera lo que falte y lo escribe acá solo.
# ---------------------------------------------------------------------

# PÚBLICA. Viaja al navegador, es su función. Además de acá, tenés que
# cargarla en Vercel (Settings → Environment Variables) y redeployar:
# .env.local no llega al build de producción.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=

# PRIVADA. Secreta. Nunca con prefijo NEXT_PUBLIC_, nunca en Vercel,
# nunca en el repo. Sólo la usa la Edge Function.
VAPID_PRIVATE_KEY=

# Un mailto: tuyo. Es lo que exige el estándar para que el servicio de
# push sepa a quién reclamarle si algo se manda mal.
VAPID_SUBJECT=mailto:tu@mail.com

# Secreta. Es la contraseña con la que la base llama a la Edge Function,
# para que nadie más pueda dispararla.
PUSH_TOKEN=

# El ref de tu proyecto de Supabase (lo que va antes de .supabase.co).
# Se usa para armar la URL de la función. Si no lo ponés, el script lo
# deduce de NEXT_PUBLIC_SUPABASE_URL.
SUPABASE_PROJECT_REF=
