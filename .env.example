# Copiar a .env.local y completar con los datos del proyecto de Supabase
# (Project Settings -> API). El .env.local NO se sube al repo.

NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu-anon-key

# No agregues acá la service_role key: saltea RLS por completo y el frontend
# no la necesita.

# Notificaciones push. Generá el par con:
#   npx web-push generate-vapid-keys
# La PÚBLICA va acá y en las variables de entorno de Vercel.
# La PRIVADA va como secreto de la Edge Function y NUNCA en el repo:
#   supabase secrets set VAPID_PRIVATE_KEY=...
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
